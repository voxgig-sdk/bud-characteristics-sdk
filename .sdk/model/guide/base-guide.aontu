guide: {
  metrics: count: entity: 1
  metrics: count: path: 5
  metrics: count: method: 5

  entity: retrieve_customer_characteristic: {
    path: "/characteristics/v1/customer": {
      op: list: method: *GET
      op: list: transform: res: *("`body.data`")|top
    }
    path: "/characteristics/v1/customer/credit-card": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
    path: "/characteristics/v1/customer/loan": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
    path: "/characteristics/v1/customer/overdraft": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
    path: "/characteristics/v1/customer/saver": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
  }

}