{
 "openapi": "3.0.3",
 "info": {
  "title": "Characteristics API",
  "version": "1.0.0",
  "contact": {
   "name": "API Support",
   "url": "http://www.thisisbud.com/support",
   "email": "contact@thisisbud.com"
  },
  "x-logo": {
   "url": "data:image/png;base64,"
  },
  "description": "\nThe Characteristics API provides endpoints for retrieving specific characteristics that apply to an individual\nCustomer based on their financial data. The currently supported characteristics are:\n\n| Characteristic | Description |\n|:---------------|:---------------------------------------------------------------------------------------------|\n| `credit_card`  | Customer has made credit card repayments                                                     |\n| `loan`         | Customer has made loan repayments (excluding credit cards)                                   |\n| `overdraft`    | Customer has paid overdraft fees                                                             |\n| `saver`        | Customer has savings transactions                                                            |\n\nNew characteristics will be released and added to this list without a breaking change notice.\n"
 },
 "servers": [
  {
   "url": "https://api-sandbox.thisisbud.com",
   "description": "Bud sandbox"
  }
 ],
 "paths": {
  "/characteristics/v1/customer": {
   "get": {
    "tags": [
     "Retrieve Customer Characteristics"
    ],
    "summary": "Retrieve Customer Characteristics",
    "description": "Retrieves a collection of characteristics associated with an individual Customer. \nFor data on why an individual characteristic applies to a Customer, use the relevant detailed endpoint.\n\nThe currently supported characteristics are:\n\n| Characteristic | Description                                                |\n|:---------------|:-----------------------------------------------------------|\n| `credit_card`  | Customer has made credit card repayments                   |\n| `loan`         | Customer has made loan repayments (excluding credit cards) |\n| `overdraft`    | Customer has paid overdraft fees                           |\n| `saver`        | Customer has savings transactions                          |\n\nNew characteristics will be released and added to this list without a breaking change notice.\n",
    "operationId": "characteristics_v1_customer_get",
    "security": [
     {
      "OAuth2": []
     }
    ],
    "parameters": [
     {
      "in": "header",
      "name": "X-Client-Id",
      "schema": {
       "type": "string"
      },
      "required": true,
      "description": "The API Client Identifier (Service Application Identifier).",
      "example": "8711bbef-b357-4c2d-97ca-0d9df4206e9a"
     },
     {
      "in": "header",
      "name": "X-Customer-Id",
      "schema": {
       "type": "string",
       "format": "uuid"
      },
      "required": true,
      "description": "A unique identifier for a Customer, as registered on Bud's platform.",
      "example": "c3339af9-2426-44d4-9c4d-ddb8fd281e23"
     },
     {
      "in": "header",
      "name": "X-Customer-Idempotent-Identifier",
      "schema": {
       "type": "string"
      },
      "description": "Use the internal client identifier, provided in the `client_metadata` object when creating the customer in __Create Customer V3__, in place of an `X-Customer-Id` header.\n"
     },
     {
      "in": "header",
      "name": "X-Customer-Secret",
      "schema": {
       "type": "string"
      },
      "required": false,
      "description": "The Bud Customer secret used to encrypt customer data. This is required only if the customer secret is not already stored with Bud."
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "title": "Retrieve Customer Characteristics Response",
         "type": "object",
         "required": [
          "operation_id",
          "data"
         ],
         "properties": {
          "operation_id": {
           "type": "string",
           "enum": [
            "characteristics_v1_customer_get"
           ]
          },
          "data": {
           "type": "array",
           "items": {
            "title": "Customer Characteristic",
            "type": "object",
            "properties": {
             "type": {
              "title": "Characteristic Type",
              "type": "string",
              "description": "The type of customer characteristic. Currently supported values include:\n- `credit_card`\n- `loan`\n- `overdraft`\n- `saver`\n\nHowever clients integrating with this endpoint should expect more to be added without notice.\n"
             },
             "link": {
              "title": "Characteristic Details Link",
              "type": "string",
              "description": "The URL to follow to get detailed Characteristic information about the customer."
             }
            }
           }
          }
         }
        },
        "examples": {
         "Multiple Characteristics": {
          "value": {
           "operation_id": "characteristics_v1_customer_get",
           "data": [
            {
             "type": "credit_card",
             "link": "characteristics/v1/customer/credit_card"
            },
            {
             "type": "loan",
             "link": "characteristics/v1/customer/loan"
            },
            {
             "type": "overdraft",
             "link": "characteristics/v1/customer/overdraft"
            },
            {
             "type": "saver",
             "link": "characteristics/v1/customer/saver"
            }
           ]
          }
         },
         "No Characteristics": {
          "value": {
           "operation_id": "characteristics_v1_customer_get",
           "data": []
          }
         }
        }
       }
      }
     },
     "401": {
      "description": "Unauthorised request"
     },
     "5XX": {
      "description": "An unexpected error occurred on the server side"
     }
    }
   }
  },
  "/characteristics/v1/customer/credit-card": {
   "get": {
    "tags": [
     "Retrieve Customer Characteristics"
    ],
    "summary": "Retrieve Customer Characteristics - Credit Card",
    "description": "Retrieves detailed information for a customer that marks them as a credit card user.\n",
    "operationId": "characteristics_v1_customer_credit_card_get",
    "security": [
     {
      "OAuth2": []
     }
    ],
    "parameters": [
     {
      "$ref": "#/paths/~1characteristics~1v1~1customer/get/parameters/0"
     },
     {
      "$ref": "#/paths/~1characteristics~1v1~1customer/get/parameters/1"
     },
     {
      "$ref": "#/paths/~1characteristics~1v1~1customer/get/parameters/2"
     },
     {
      "$ref": "#/paths/~1characteristics~1v1~1customer/get/parameters/3"
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "title": "Get Credit Card Customer Characteristics Response",
         "type": "object",
         "required": [
          "operation_id",
          "data"
         ],
         "properties": {
          "operation_id": {
           "type": "string",
           "enum": [
            "characteristics_v1_customer_credit_card_get"
           ]
          },
          "data": {
           "type": "object",
           "properties": {
            "credit_card_transactions": {
             "type": "array",
             "items": {
              "$ref": "#/paths/~1characteristics~1v1~1customer~1loan/get/responses/200/content/application~1json/schema/properties/data/properties/loan_transactions/items"
             }
            },
            "credit_card_transaction_totals": {
             "type": "array",
             "items": {
              "$ref": "#/paths/~1characteristics~1v1~1customer~1loan/get/responses/200/content/application~1json/schema/properties/data/properties/loan_transaction_totals/items"
             }
            }
           }
          }
         }
        },
        "example": {
         "operation_id": "characteristics_v1_customer_credit_card_get",
         "data": {
          "credit_card_transactions": [
           {
